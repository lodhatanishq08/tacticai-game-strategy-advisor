PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# IBM WatsonX AI - Granite (Optional)
# Add your credentials here to enable IBM Granite LLM
# Without these, the app uses the local rule-based reasoning engine
IBM_API_KEY=
IBM_PROJECT_ID=
IBM_ENDPOINT=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL=ibm/granite-13b-instruct-v2
